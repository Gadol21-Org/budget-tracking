PAAMONIM_USERNAME=
PAAMONIM_PASSWORD=
# Writes new entries to Paamonim (rounded to whole shekels). Off unless set to 1.
PAAMONIM_MIRROR=0
# Optional overrides
PAAMONIM_BASE_URL=https://app.paamonim.org.il
# Storage backend: sqlite (default, local/tests) or nosql (Oracle NoSQL)
STORAGE=sqlite
DATABASE_URL=budget.db
# --- STORAGE=nosql, local Cloud Simulator ---
# ORACLE_NOSQL_AUTH=cloudsim
# ORACLE_NOSQL_ENDPOINT=http://localhost:8080
# --- STORAGE=nosql, Oracle NoSQL Cloud ---
# ORACLE_NOSQL_AUTH=user
# ORACLE_NOSQL_AUTH_FILE=~/.oci/config
# ORACLE_NOSQL_REGION=us-phoenix-1
# ORACLE_NOSQL_COMPARTMENT_ID=ocid1.compartment...
BIND_ADDR=127.0.0.1:3000
# Google Sheets snapshot export (service account key as base64 on one line, or raw JSON)
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# GOOGLE_SHEET_ID=
# SHEETS_EXPORT_INTERVAL_HOURS=24
