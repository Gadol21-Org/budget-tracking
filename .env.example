PAAMONIM_USERNAME=
PAAMONIM_PASSWORD=
# New/edited/deleted entries are kept in step with Paamonim (rounded to whole shekels) whenever
# the credentials above are set. Set to 0 to turn that off.
# PAAMONIM_MIRROR=0
# Try first: report what would be sent and change nothing.
# PAAMONIM_MIRROR_DRY_RUN=1
# Override the delete-line endpoint (default POST /rishumit/delete_history_line, param line_id).
# PAAMONIM_DELETE_PATH=
# PAAMONIM_DELETE_PARAM=line_id
# PAAMONIM_MIRROR_MAX_OPS=50
# PAAMONIM_MIRROR_INTERVAL_MINUTES=10
# Optional overrides
PAAMONIM_BASE_URL=https://app.paamonim.org.il
# MySQL 8 (HeatWave or any server); percent-encode special characters in the password.
# The database is created on first start. Locally: `docker compose up -d` starts this one.
MYSQL_URL=mysql://root:budget@127.0.0.1:3306/budget
BIND_ADDR=127.0.0.1:3000
# Google Sheets snapshot export (service account key as base64 on one line, or raw JSON)
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# GOOGLE_SHEET_ID=
# SHEETS_EXPORT_INTERVAL_HOURS=24

# Sumit (sumit.co.il) receipts: polled at 07:00, 13:00 and 19:00 Israel time and imported as income.
# Server secrets: never commit them. The API allows ~250 calls/month; every call is counted.
# SUMIT_API_KEY=
# SUMIT_COMPANY_ID=
# SUMIT_POLL_HOURS=7,13,19
# SUMIT_MONTHLY_CALL_LIMIT=240
# Later step (not implemented yet): append a row per receipt to this Google Sheet
# SUMIT_SHEET_ID=
# Web push for "new receipt" notifications. Generate the pair with:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -out vapid.pem
#   VAPID_PRIVATE_KEY_PEM_B64=$(base64 -w0 vapid.pem)
#   VAPID_PUBLIC_KEY=$(openssl ec -in vapid.pem -pubout -outform DER 2>/dev/null | tail -c 65 | basenc --base64url -w0 | tr -d =)
# VAPID_PRIVATE_KEY_PEM_B64=
# VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:you@example.com
